#import <UIKit/UIKit.h>
#import <PhotosUI/PhotosUI.h>
#import <UniformTypeIdentifiers/UniformTypeIdentifiers.h>

#include "launcher.h"
#include "zip_import.h"
#include <string.h>

// ============================================================================
// Storage keys
// ============================================================================

static NSString *const IOSGamesKey          = @"ios.games";
static NSString *const IOSSelectedGameKey   = @"ios.selectedGame";
static NSString *const IOSLazyRoomsKey      = @"ios.lazyRooms";
static NSString *const IOSLazyTexturesKey   = @"ios.lazyTextures";
static NSString *const IOSLazyAudioKey      = @"ios.lazyAudio";
static NSString *const IOSTouchControlsKey  = @"ios.touchControls";
static NSString *const IOSSpeedKey           = @"ios.speed";
static NSString *const IOSWidescreenKey     = @"ios.widescreen";

// Games are stored with paths relative to gamesDirectory().
//
// Example:
//   "<uuid>/data.win"
//   "<uuid>"
//   "<uuid>/Saves"
//   "<uuid>/icon.png"

static NSString *const GameKeyId          = @"id";
static NSString *const GameKeyName        = @"name";
static NSString *const GameKeyDescription = @"description";
static NSString *const GameKeyDataWinRel  = @"dataWinRel";
static NSString *const GameKeyDirRel      = @"dirRel";
static NSString *const GameKeySaveDirRel  = @"saveDirRel";
static NSString *const GameKeyIconRel     = @"iconRel";

static UIWindow *launcherWindow;
static char *launcherArgv0;

// ============================================================================
// Palette / metrics
// ============================================================================

@interface BSTheme : NSObject
+ (UIColor *)accent;
+ (UIColor *)cardBackground;
+ (UIColor *)secondaryText;
@end

@implementation BSTheme

+ (UIColor *)accent {
    return [UIColor colorWithRed:1.0
                           green:0.62
                            blue:0.16
                           alpha:1.0];
}

+ (UIColor *)cardBackground {
    return [UIColor secondarySystemGroupedBackgroundColor];
}

+ (UIColor *)secondaryText {
    return [UIColor secondaryLabelColor];
}

@end

// ============================================================================
// Persistence helpers
// ============================================================================

static void registerDefaults(void) {
    NSDictionary *defaults = @{
        IOSLazyRoomsKey: @YES,
        IOSLazyTexturesKey: @YES,
        IOSLazyAudioKey: @YES,
        IOSTouchControlsKey: @YES,
        IOSSpeedKey: @1.0,
        IOSWidescreenKey: @NO,
    };

    [[NSUserDefaults standardUserDefaults]
        registerDefaults:defaults];
}

static NSURL *gamesDirectory(void) {
    NSFileManager *manager =
        [NSFileManager defaultManager];

    NSURL *support =
        [[manager URLsForDirectory:NSApplicationSupportDirectory
                         inDomains:NSUserDomainMask]
            firstObject];

    NSURL *directory =
        [support URLByAppendingPathComponent:@"Butterscotch/Games"
                                 isDirectory:YES];

    [manager createDirectoryAtURL:directory
       withIntermediateDirectories:YES
                        attributes:nil
                             error:nil];

    return directory;
}

static NSString *absolutePathForRelative(NSString *relativePath) {
    if (relativePath.length == 0) {
        return relativePath;
    }

    return [gamesDirectory()
        URLByAppendingPathComponent:relativePath]
        .path;
}

static NSMutableArray *storedGames(void) {
    NSArray *saved =
        [[NSUserDefaults standardUserDefaults]
            arrayForKey:IOSGamesKey];

    if (saved) {
        return [[saved mutableCopy] autorelease];
    }

    return [NSMutableArray array];
}

static void saveGames(NSArray *games) {
    [[NSUserDefaults standardUserDefaults]
        setObject:games
           forKey:IOSGamesKey];
}

// ============================================================================
// Game path helpers
// ============================================================================

static NSString *gameDataWinAbsolute(NSDictionary *game) {
    return absolutePathForRelative(game[GameKeyDataWinRel]);
}

static NSString *gameDirectoryAbsolute(NSDictionary *game) {
    return absolutePathForRelative(game[GameKeyDirRel]);
}

static NSString *gameSaveDirAbsolute(NSDictionary *game) {
    return absolutePathForRelative(game[GameKeySaveDirRel]);
}

static NSString *gameIconAbsolute(NSDictionary *game) {
    NSString *relativePath = game[GameKeyIconRel];

    if (relativePath.length == 0) {
        return nil;
    }

    return absolutePathForRelative(relativePath);
}

static UIImage *gameIconImage(NSDictionary *game) {
    NSString *path = gameIconAbsolute(game);

    if (path.length == 0) {
        return nil;
    }

    if (![[NSFileManager defaultManager]
            fileExistsAtPath:path]) {
        return nil;
    }

    return [UIImage imageWithContentsOfFile:path];
}

// ============================================================================
// Error UI
// ============================================================================

static void showError(UIViewController *controller,
                      NSString *message) {

    UIAlertController *alert =
        [UIAlertController
            alertControllerWithTitle:@"Import Failed"
                             message:message
                      preferredStyle:UIAlertControllerStyleAlert];

    [alert addAction:
        [UIAlertAction
            actionWithTitle:@"OK"
                      style:UIAlertActionStyleDefault
                    handler:nil]];

    [controller presentViewController:alert
                             animated:YES
                           completion:nil];
}

// ============================================================================
// Empty state
// ============================================================================

@interface BSEmptyStateView : UIView

+ (instancetype)viewWithSymbol:(NSString *)symbolName
                          title:(NSString *)title
                        message:(NSString *)message;

@end

@implementation BSEmptyStateView

+ (instancetype)viewWithSymbol:(NSString *)symbolName
                          title:(NSString *)title
                        message:(NSString *)message {

    BSEmptyStateView *view =
        [[[self alloc] initWithFrame:CGRectZero] autorelease];

    UIImageView *icon =
        [[[UIImageView alloc] init] autorelease];

    UIImageSymbolConfiguration *config =
        [UIImageSymbolConfiguration
            configurationWithPointSize:44
                                weight:UIImageSymbolWeightLight];

    icon.image =
        [[UIImage systemImageNamed:symbolName
                withConfiguration:config]
            imageWithRenderingMode:UIImageRenderingModeAlwaysTemplate];

    icon.tintColor = UIColor.tertiaryLabelColor;
    icon.contentMode = UIViewContentModeCenter;
    icon.translatesAutoresizingMaskIntoConstraints = NO;

    UILabel *titleLabel =
        [[[UILabel alloc] init] autorelease];

    titleLabel.text = title;
    titleLabel.font =
        [UIFont systemFontOfSize:20
                          weight:UIFontWeightSemibold];

    titleLabel.textColor = UIColor.labelColor;
    titleLabel.textAlignment = NSTextAlignmentCenter;
    titleLabel.translatesAutoresizingMaskIntoConstraints = NO;

    UILabel *messageLabel =
        [[[UILabel alloc] init] autorelease];

    messageLabel.text = message;
    messageLabel.font =
        [UIFont systemFontOfSize:15];

    messageLabel.textColor = BSTheme.secondaryText;
    messageLabel.textAlignment = NSTextAlignmentCenter;
    messageLabel.numberOfLines = 0;
    messageLabel.translatesAutoresizingMaskIntoConstraints = NO;

    UIStackView *stack =
        [[[UIStackView alloc]
            initWithArrangedSubviews:@[
                icon,
                titleLabel,
                messageLabel
            ]]
            autorelease];

    stack.axis = UILayoutConstraintAxisVertical;
    stack.alignment = UIStackViewAlignmentCenter;
    stack.spacing = 10;
    stack.translatesAutoresizingMaskIntoConstraints = NO;

    [view addSubview:stack];

    [NSLayoutConstraint activateConstraints:@[
        [stack.centerXAnchor
            constraintEqualToAnchor:view.centerXAnchor],

        [stack.centerYAnchor
            constraintEqualToAnchor:view.centerYAnchor],

        [stack.widthAnchor
            constraintLessThanOrEqualToAnchor:view.widthAnchor
                                    constant:-64],
    ]];

    return view;
}

@end

// ============================================================================
// Game cell
// ============================================================================

@interface BSGameCell : UITableViewCell

@property(nonatomic, retain) UIView *badgeView;
@property(nonatomic, retain) UILabel *badgeLabel;
@property(nonatomic, retain) UIImageView *iconView;
@property(nonatomic, retain) UILabel *titleLabel;
@property(nonatomic, retain) UILabel *subtitleLabel;

- (void)configureWithName:(NSString *)name
                 subtitle:(NSString *)subtitle
                     icon:(UIImage *)icon;

@end

@implementation BSGameCell

- (instancetype)initWithStyle:(UITableViewCellStyle)style
               reuseIdentifier:(NSString *)reuseIdentifier {

    self =
        [super initWithStyle:UITableViewCellStyleDefault
            reuseIdentifier:reuseIdentifier];

    if (!self) {
        return nil;
    }

    self.selectionStyle =
        UITableViewCellSelectionStyleDefault;

    self.backgroundColor =
        UIColor.clearColor;

    UIView *card =
        [[UIView alloc] init];

    card.backgroundColor =
        BSTheme.cardBackground;

    card.layer.cornerRadius = 14.0;
    card.layer.cornerCurve =
        kCACornerCurveContinuous;

    card.translatesAutoresizingMaskIntoConstraints = NO;
    card.tag = 100;

    [self.contentView addSubview:card];
    [card release];

    // ------------------------------------------------------------
    // Custom icon
    // ------------------------------------------------------------

    _iconView =
        [[UIImageView alloc] init];

    _iconView.backgroundColor =
        [BSTheme.accent colorWithAlphaComponent:0.16];

    _iconView.layer.cornerRadius = 10.0;
    _iconView.layer.cornerCurve =
        kCACornerCurveContinuous;

    _iconView.clipsToBounds = YES;
    _iconView.contentMode =
        UIViewContentModeScaleAspectFill;

    _iconView.translatesAutoresizingMaskIntoConstraints = NO;

    [card addSubview:_iconView];

    // ------------------------------------------------------------
    // Fallback letter badge
    // ------------------------------------------------------------

    _badgeView =
        [[UIView alloc] init];

    _badgeView.backgroundColor =
        [BSTheme.accent colorWithAlphaComponent:0.16];

    _badgeView.layer.cornerRadius = 10.0;
    _badgeView.layer.cornerCurve =
        kCACornerCurveContinuous;

    _badgeView.translatesAutoresizingMaskIntoConstraints = NO;
    _badgeView.hidden = YES;

    [card addSubview:_badgeView];

    _badgeLabel =
        [[UILabel alloc] init];

    _badgeLabel.font =
        [UIFont systemFontOfSize:20
                          weight:UIFontWeightBold];

    _badgeLabel.textColor =
        BSTheme.accent;

    _badgeLabel.textAlignment =
        NSTextAlignmentCenter;

    _badgeLabel.translatesAutoresizingMaskIntoConstraints = NO;

    [_badgeView addSubview:_badgeLabel];

    // ------------------------------------------------------------
    // Text
    // ------------------------------------------------------------

    _titleLabel =
        [[UILabel alloc] init];

    _titleLabel.font =
        [UIFont systemFontOfSize:17
                          weight:UIFontWeightSemibold];

    _titleLabel.textColor =
        UIColor.labelColor;

    _titleLabel.translatesAutoresizingMaskIntoConstraints = NO;

    _subtitleLabel =
        [[UILabel alloc] init];

    _subtitleLabel.font =
        [UIFont systemFontOfSize:13];

    _subtitleLabel.textColor =
        BSTheme.secondaryText;

    _subtitleLabel.translatesAutoresizingMaskIntoConstraints = NO;

    UIStackView *textStack =
        [[UIStackView alloc]
            initWithArrangedSubviews:@[
                _titleLabel,
                _subtitleLabel
            ]];

    textStack.axis =
        UILayoutConstraintAxisVertical;

    textStack.spacing = 2;
    textStack.translatesAutoresizingMaskIntoConstraints = NO;

    [card addSubview:textStack];
    [textStack release];

    // ------------------------------------------------------------
    // Chevron
    // ------------------------------------------------------------

    UIImageView *chevron =
        [[UIImageView alloc] init];

    UIImageSymbolConfiguration *chevronConfig =
        [UIImageSymbolConfiguration
            configurationWithPointSize:13
                                weight:UIImageSymbolWeightSemibold];

    chevron.image =
        [[UIImage systemImageNamed:@"chevron.right"
                withConfiguration:chevronConfig]
            imageWithRenderingMode:
                UIImageRenderingModeAlwaysTemplate];

    chevron.tintColor =
        UIColor.tertiaryLabelColor;

    chevron.translatesAutoresizingMaskIntoConstraints = NO;

    [card addSubview:chevron];
    [chevron release];

    // ------------------------------------------------------------
    // Constraints
    // ------------------------------------------------------------

    [NSLayoutConstraint activateConstraints:@[

        [card.leadingAnchor
            constraintEqualToAnchor:
                self.contentView.leadingAnchor
            constant:16],

        [card.trailingAnchor
            constraintEqualToAnchor:
                self.contentView.trailingAnchor
            constant:-16],

        [card.topAnchor
            constraintEqualToAnchor:
                self.contentView.topAnchor
            constant:5],

        [card.bottomAnchor
            constraintEqualToAnchor:
                self.contentView.bottomAnchor
            constant:-5],

        // Icon

        [_iconView.leadingAnchor
            constraintEqualToAnchor:
                card.leadingAnchor
            constant:12],

        [_iconView.centerYAnchor
            constraintEqualToAnchor:
                card.centerYAnchor],

        [_iconView.widthAnchor
            constraintEqualToConstant:44],

        [_iconView.heightAnchor
            constraintEqualToConstant:44],

        // Badge

        [_badgeView.leadingAnchor
            constraintEqualToAnchor:
                card.leadingAnchor
            constant:12],

        [_badgeView.centerYAnchor
            constraintEqualToAnchor:
                card.centerYAnchor],

        [_badgeView.widthAnchor
            constraintEqualToConstant:44],

        [_badgeView.heightAnchor
            constraintEqualToConstant:44],

        [_badgeLabel.centerXAnchor
            constraintEqualToAnchor:
                _badgeView.centerXAnchor],

        [_badgeLabel.centerYAnchor
            constraintEqualToAnchor:
                _badgeView.centerYAnchor],

        // Text

        [textStack.leadingAnchor
            constraintEqualToAnchor:
                _iconView.trailingAnchor
            constant:12],

        [textStack.centerYAnchor
            constraintEqualToAnchor:
                card.centerYAnchor],

        [textStack.trailingAnchor
            constraintLessThanOrEqualToAnchor:
                chevron.leadingAnchor
            constant:-8],

        // Chevron

        [chevron.trailingAnchor
            constraintEqualToAnchor:
                card.trailingAnchor
            constant:-14],

        [chevron.centerYAnchor
            constraintEqualToAnchor:
                card.centerYAnchor],
    ]];

    return self;
}

- (void)prepareForReuse {
    [super prepareForReuse];

    self.iconView.image = nil;
    self.iconView.hidden = NO;

    self.badgeView.hidden = YES;
    self.badgeLabel.text = nil;
}

- (void)configureWithName:(NSString *)name
                 subtitle:(NSString *)subtitle
                     icon:(UIImage *)icon {

    self.titleLabel.text = name;
    self.subtitleLabel.text = subtitle;

    if (icon) {

        self.iconView.image = icon;
        self.iconView.hidden = NO;

        self.badgeView.hidden = YES;

    } else {

        self.iconView.image = nil;
        self.iconView.hidden = YES;

        self.badgeView.hidden = NO;

        NSString *first =
            name.length
                ? [name substringToIndex:1].uppercaseString
                : @"?";

        self.badgeLabel.text = first;
    }
}

- (void)dealloc {

    [_badgeView release];
    [_badgeLabel release];
    [_iconView release];
    [_titleLabel release];
    [_subtitleLabel release];

    [super dealloc];
}

@end

// ============================================================================
// Play tab
// ============================================================================

@interface BSPlayController : UITableViewController
@end

@implementation BSPlayController

- (void)viewDidLoad {

    [super viewDidLoad];

    self.title = @"Play";

    self.tableView.backgroundColor =
        UIColor.systemGroupedBackgroundColor;

    self.tableView.separatorStyle =
        UITableViewCellSeparatorStyleNone;

    self.tableView.rowHeight = 78.0;

    self.navigationController.navigationBar.prefersLargeTitles = YES;

    [self.tableView
        registerClass:[BSGameCell class]
        forCellReuseIdentifier:@"game"];
}

- (void)viewWillAppear:(BOOL)animated {

    [super viewWillAppear:animated];

    [self.tableView reloadData];
}

- (NSInteger)numberOfSectionsInTableView:
    (UITableView *)tableView {

    return 1;
}

- (NSInteger)tableView:(UITableView *)tableView
 numberOfRowsInSection:(NSInteger)section {

    NSInteger count =
        storedGames().count;

    if (count == 0) {

        self.tableView.backgroundView =
            [BSEmptyStateView
                viewWithSymbol:@"gamecontroller"
                title:@"No Games Yet"
                message:
                    @"Import a GameMaker ZIP from the Games tab to get started."];

    } else {

        self.tableView.backgroundView = nil;
    }

    return count;
}

- (NSString *)tableView:(UITableView *)tableView
 titleForHeaderInSection:(NSInteger)section {

    return storedGames().count
        ? @"Library"
        : nil;
}

- (UITableViewCell *)tableView:(UITableView *)tableView
         cellForRowAtIndexPath:(NSIndexPath *)indexPath {

    NSArray *games =
        storedGames();

    BSGameCell *cell =
        [tableView
            dequeueReusableCellWithIdentifier:@"game"
                                  forIndexPath:indexPath];

    NSDictionary *game =
        games[indexPath.row];

    NSString *description =
        game[GameKeyDescription];

    UIImage *icon =
        gameIconImage(game);

    [cell configureWithName:game[GameKeyName]
                    subtitle:
                        description.length
                            ? description
                            : @"Tap to play"
                        icon:icon];

    return cell;
}

- (void)tableView:(UITableView *)tableView
didSelectRowAtIndexPath:(NSIndexPath *)indexPath {

    [tableView deselectRowAtIndexPath:indexPath
                             animated:YES];

    NSArray *games =
        storedGames();

    if (games.count == 0) {
        return;
    }

    NSDictionary *game =
        games[indexPath.row];

    NSString *dataWinPath =
        gameDataWinAbsolute(game);

    if (![[NSFileManager defaultManager]
            fileExistsAtPath:dataWinPath]) {

        showError(
            self,
            @"This game's data.win is missing. Delete this entry and import the ZIP again."
        );

        return;
    }

    UIImpactFeedbackGenerator *feedback =
        [[[UIImpactFeedbackGenerator alloc]
            initWithStyle:UIImpactFeedbackStyleMedium]
            autorelease];

    [feedback impactOccurred];

    [[NSUserDefaults standardUserDefaults]
        setObject:game[GameKeyId]
           forKey:IOSSelectedGameKey];

    IOSLaunchSettings settings = {
        .lazyRooms =
            [[NSUserDefaults standardUserDefaults]
                boolForKey:IOSLazyRoomsKey],

        .lazyTextures =
            [[NSUserDefaults standardUserDefaults]
                boolForKey:IOSLazyTexturesKey],

        .lazyAudio =
            [[NSUserDefaults standardUserDefaults]
                boolForKey:IOSLazyAudioKey],

        .touchControls =
            [[NSUserDefaults standardUserDefaults]
                boolForKey:IOSTouchControlsKey],

        .speedMultiplier =
            [[NSUserDefaults standardUserDefaults]
                doubleForKey:IOSSpeedKey],

        .widescreenAspect =
            [[NSUserDefaults standardUserDefaults]
                boolForKey:IOSWidescreenKey]
                ? (16.0f / 9.0f)
                : 0.0f,
    };

    launcherWindow.hidden = YES;

    IOSLauncher_startGame(
        [dataWinPath fileSystemRepresentation],
        [gameSaveDirAbsolute(game) fileSystemRepresentation],
        &settings,
        launcherArgv0
    );

    launcherWindow.hidden = NO;

    [launcherWindow makeKeyAndVisible];
}

@end

// ============================================================================
// Games tab
// ============================================================================

@interface BSGamesController : UITableViewController
    <UIDocumentPickerDelegate, PHPickerViewControllerDelegate>

@property(nonatomic, assign) BOOL choosingIcon;

@property(nonatomic, retain) NSString *pendingIdentifier;
@property(nonatomic, retain) NSString *pendingDataWinRel;
@property(nonatomic, retain) NSString *pendingDirRel;
@property(nonatomic, retain) NSString *pendingSaveDirRel;
@property(nonatomic, retain) NSString *pendingDefaultName;
@property(nonatomic, retain) NSString *pendingDescription;
@property(nonatomic, retain) UIImage *pendingIcon;

// YES when editing an existing game instead of importing one.
@property(nonatomic, assign) BOOL editingExistingGame;

- (void)askForMetadataWithIdentifier:(NSString *)identifier
                          dataWinRel:(NSString *)dataWinRel
                             dirRel:(NSString *)dirRel
                         saveDirRel:(NSString *)saveDirRel
                        defaultName:(NSString *)defaultName;

- (void)presentMetadataAlert;
- (void)chooseIconSource;
- (void)chooseIconFromPhotos;
- (void)chooseIconFromFiles;
- (BOOL)savePendingIconForGameIdentifier:(NSString *)identifier;
- (void)finishAddingPendingGame;
- (void)clearPendingGame;

@end

@implementation BSGamesController

// ============================================================================
// View setup
// ============================================================================

- (void)viewDidLoad {

    [super viewDidLoad];

    self.title = @"Games";

    self.tableView.backgroundColor =
        UIColor.systemGroupedBackgroundColor;

    self.tableView.separatorStyle =
        UITableViewCellSeparatorStyleNone;

    self.tableView.rowHeight = 78.0;

    self.navigationController.navigationBar.prefersLargeTitles = YES;

    [self.tableView
        registerClass:[BSGameCell class]
        forCellReuseIdentifier:@"libraryGame"];

    self.navigationItem.rightBarButtonItem =
        [[[UIBarButtonItem alloc]
            initWithBarButtonSystemItem:UIBarButtonSystemItemAdd
                                 target:self
                                 action:@selector(importGame:)]
            autorelease];
}

- (void)viewWillAppear:(BOOL)animated {

    [super viewWillAppear:animated];

    [self.tableView reloadData];
}

// ============================================================================
// Table
// ============================================================================

- (NSInteger)tableView:(UITableView *)tableView
 numberOfRowsInSection:(NSInteger)section {

    NSInteger count =
        storedGames().count;

    if (count == 0) {

        self.tableView.backgroundView =
            [BSEmptyStateView
                viewWithSymbol:@"plus.rectangle.on.folder"
                title:@"Your Library Is Empty"
                message:
                    @"Tap + to import a GameMaker ZIP containing a data.win."];

    } else {

        self.tableView.backgroundView = nil;
    }

    return count;
}

- (UITableViewCell *)tableView:(UITableView *)tableView
         cellForRowAtIndexPath:(NSIndexPath *)indexPath {

    NSArray *games =
        storedGames();

    BSGameCell *cell =
        [tableView
            dequeueReusableCellWithIdentifier:@"libraryGame"
                                  forIndexPath:indexPath];

    NSDictionary *game =
        games[indexPath.row];

    NSString *description =
        game[GameKeyDescription];

    UIImage *icon =
        gameIconImage(game);

    [cell configureWithName:game[GameKeyName]
                    subtitle:
                        description.length
                            ? description
                            : @"Imported GameMaker game"
                        icon:icon];

    cell.selectionStyle =
        UITableViewCellSelectionStyleNone;

    return cell;
}

// ============================================================================
// Delete game
// ============================================================================

- (BOOL)tableView:(UITableView *)tableView
canEditRowAtIndexPath:(NSIndexPath *)indexPath {

    return storedGames().count > 0;
}

- (UISwipeActionsConfiguration *)
    tableView:(UITableView *)tableView
    trailingSwipeActionsConfigurationForRowAtIndexPath:
        (NSIndexPath *)indexPath {

    UIContextualAction *edit =
        [UIContextualAction
            contextualActionWithStyle:UIContextualActionStyleNormal
            title:@"Edit"
            handler:^(UIContextualAction *action,
                      UIView *sourceView,
                      void (^completionHandler)(BOOL)) {

        [self editGameAtIndexPath:indexPath];

        completionHandler(YES);
    }];

    edit.backgroundColor = BSTheme.accent;

    UIContextualAction *delete =
        [UIContextualAction
            contextualActionWithStyle:UIContextualActionStyleDestructive
            title:@"Delete"
            handler:^(UIContextualAction *action,
                      UIView *sourceView,
                      void (^completionHandler)(BOOL)) {

        NSMutableArray *games = storedGames();

        if (indexPath.row >= games.count) {
            completionHandler(NO);
            return;
        }

        NSDictionary *game = games[indexPath.row];

        NSString *gameDirectory =
            gameDirectoryAbsolute(game);

        if (gameDirectory.length > 0) {
            [[NSFileManager defaultManager]
                removeItemAtPath:gameDirectory
                           error:nil];
        }

        [games removeObjectAtIndex:indexPath.row];

        saveGames(games);

        NSString *selected =
            [[NSUserDefaults standardUserDefaults]
                stringForKey:IOSSelectedGameKey];

        if ([selected isEqualToString:game[GameKeyId]]) {
            [[NSUserDefaults standardUserDefaults]
                removeObjectForKey:IOSSelectedGameKey];
        }

        [tableView
            deleteRowsAtIndexPaths:@[indexPath]
                  withRowAnimation:UITableViewRowAnimationFade];

        if (games.count == 0) {
            tableView.backgroundView =
                [BSEmptyStateView
                    viewWithSymbol:@"plus.rectangle.on.folder"
                    title:@"Your Library Is Empty"
                    message:
                        @"Tap + to import a GameMaker ZIP containing a data.win."];
        }

        completionHandler(YES);
    }];

    // UIKit expects the ACTIONS to be wrapped in this configuration.
    UISwipeActionsConfiguration *configuration =
        [UISwipeActionsConfiguration
            configurationWithActions:@[
                delete,
                edit
            ]];

    configuration.performsFirstActionWithFullSwipe = NO;

    return configuration;
}

- (void)editGameAtIndexPath:(NSIndexPath *)indexPath {

    NSArray *games = storedGames();

    if (indexPath.row >= games.count) {
        return;
    }

    NSDictionary *game =
        games[indexPath.row];

    self.editingExistingGame = YES;

    self.pendingIdentifier =
        game[GameKeyId];

    self.pendingDataWinRel =
        game[GameKeyDataWinRel];

    self.pendingDirRel =
        game[GameKeyDirRel];

    self.pendingSaveDirRel =
        game[GameKeySaveDirRel];

    self.pendingDefaultName =
        game[GameKeyName];

    self.pendingDescription =
        game[GameKeyDescription] ?: @"";

    UIImage *existingIcon =
        gameIconImage(game);

    self.pendingIcon =
        existingIcon;

    [self presentMetadataAlert];
}




- (void)tableView:(UITableView *)tableView
commitEditingStyle:(UITableViewCellEditingStyle)style
forRowAtIndexPath:(NSIndexPath *)indexPath {

    if (style != UITableViewCellEditingStyleDelete) {
        return;
    }

    NSMutableArray *games =
        storedGames();

    NSDictionary *game =
        games[indexPath.row];

    NSString *gameDirectory =
        gameDirectoryAbsolute(game);

    if (gameDirectory.length > 0) {

        [[NSFileManager defaultManager]
            removeItemAtPath:gameDirectory
                       error:nil];
    }

    [games removeObjectAtIndex:indexPath.row];

    saveGames(games);

    NSString *selected =
        [[NSUserDefaults standardUserDefaults]
            stringForKey:IOSSelectedGameKey];

    if ([selected isEqualToString:game[GameKeyId]]) {

        [[NSUserDefaults standardUserDefaults]
            removeObjectForKey:IOSSelectedGameKey];
    }

    [tableView
        deleteRowsAtIndexPaths:@[indexPath]
              withRowAnimation:UITableViewRowAnimationFade];

    if (games.count == 0) {
        [tableView reloadData];
    }
}

// ============================================================================
// Import ZIP
// ============================================================================

- (void)importGame:(id)sender {

    self.choosingIcon = NO;

    UIDocumentPickerViewController *picker =
        [[UIDocumentPickerViewController alloc]
            initForOpeningContentTypes:@[
                [UTType typeWithIdentifier:@"public.zip-archive"]
            ]];

    picker.delegate = self;
    picker.allowsMultipleSelection = NO;

    [self presentViewController:picker
                       animated:YES
                     completion:nil];

    [picker release];
}

- (void)documentPickerWasCancelled:
    (UIDocumentPickerViewController *)controller {

    if (self.choosingIcon) {

        self.choosingIcon = NO;

        [self presentMetadataAlert];
    }
}

// ============================================================================
// Document picker
// ============================================================================

- (void)documentPicker:(UIDocumentPickerViewController *)picker
didPickDocumentsAtURLs:(NSArray<NSURL *> *)urls {

    NSURL *source =
        urls.firstObject;

    if (!source) {
        return;
    }

    // ------------------------------------------------------------
    // Selecting an icon from Files
    // ------------------------------------------------------------

    if (self.choosingIcon) {

        self.choosingIcon = NO;

        BOOL scoped =
            [source startAccessingSecurityScopedResource];

        NSData *imageData =
            [NSData dataWithContentsOfURL:source];

        if (scoped) {
            [source stopAccessingSecurityScopedResource];
        }

        UIImage *image =
            imageData.length
                ? [UIImage imageWithData:imageData]
                : nil;

        if (!image) {

            showError(
                self,
                @"The selected file is not a supported image."
            );

            [self presentMetadataAlert];

            return;
        }

        self.pendingIcon = image;

        [self presentMetadataAlert];

        return;
    }

    // ------------------------------------------------------------
    // Importing the game ZIP
    // ------------------------------------------------------------

    BOOL scoped =
        [source startAccessingSecurityScopedResource];

    NSString *identifier =
        [[NSUUID UUID] UUIDString];

    NSURL *directory =
        [gamesDirectory()
            URLByAppendingPathComponent:identifier
                            isDirectory:YES];

    [[NSFileManager defaultManager]
        createDirectoryAtURL:directory
  withIntermediateDirectories:YES
                   attributes:nil
                        error:nil];

    UIAlertController *progress =
        [UIAlertController
            alertControllerWithTitle:@"Importing Game"
                             message:@"Extracting files…"
                      preferredStyle:UIAlertControllerStyleAlert];

    [self presentViewController:progress
                       animated:YES
                     completion:nil];

    dispatch_async(
        dispatch_get_global_queue(QOS_CLASS_USER_INITIATED, 0),
        ^{

        char dataWin[4096] = {0};
        char error[512] = {0};

        BOOL extracted =
            IOSZipImport_extract(
                source.fileSystemRepresentation,
                directory.fileSystemRepresentation,
                dataWin,
                sizeof(dataWin),
                error,
                sizeof(error)
            );

        if (scoped) {
            [source stopAccessingSecurityScopedResource];
        }

        NSString *dataWinPath =
            [NSString stringWithUTF8String:dataWin];

        NSString *errorMessage =
            [NSString stringWithUTF8String:error];

        dispatch_async(
            dispatch_get_main_queue(),
            ^{

            [progress dismissViewControllerAnimated:YES
                                          completion:nil];

            if (!extracted) {

                [[NSFileManager defaultManager]
                    removeItemAtURL:directory
                             error:nil];

                showError(
                    self,
                    errorMessage.length
                        ? errorMessage
                        : @"Could not import this ZIP."
                );

                return;
            }

            if (![[NSFileManager defaultManager]
                    fileExistsAtPath:dataWinPath]) {

                [[NSFileManager defaultManager]
                    removeItemAtURL:directory
                             error:nil];

                showError(
                    self,
                    @"The ZIP importer did not produce a readable data.win."
                );

                return;
            }

            NSURL *saveDirectory =
                [directory
                    URLByAppendingPathComponent:@"Saves"
                                    isDirectory:YES];

            [[NSFileManager defaultManager]
                createDirectoryAtURL:saveDirectory
          withIntermediateDirectories:YES
                           attributes:nil
                                error:nil];

            NSString *gamesDirPath =
                gamesDirectory().path;

            NSString *dataWinRel;

            if ([dataWinPath hasPrefix:gamesDirPath]) {

                dataWinRel =
                    [dataWinPath
                        substringFromIndex:
                            gamesDirPath.length + 1];

            } else {

                dataWinRel = dataWinPath;
            }

            NSString *dirRel =
                identifier;

            NSString *saveDirRel =
                [identifier
                    stringByAppendingPathComponent:@"Saves"];

            NSString *defaultName =
                source.lastPathComponent
                    .stringByDeletingPathExtension;

            [self askForMetadataWithIdentifier:identifier
                                    dataWinRel:dataWinRel
                                       dirRel:dirRel
                                   saveDirRel:saveDirRel
                                  defaultName:defaultName];
        });
    });
}

// ============================================================================
// Metadata
// ============================================================================

- (void)askForMetadataWithIdentifier:(NSString *)identifier
                          dataWinRel:(NSString *)dataWinRel
                             dirRel:(NSString *)dirRel
                         saveDirRel:(NSString *)saveDirRel
                        defaultName:(NSString *)defaultName {

    self.pendingIdentifier = identifier;
    self.pendingDataWinRel = dataWinRel;
    self.pendingDirRel = dirRel;
    self.pendingSaveDirRel = saveDirRel;
    self.pendingDefaultName = defaultName;
    self.pendingDescription = @"";
    self.pendingIcon = nil;

    [self presentMetadataAlert];
}

- (void)presentMetadataAlert {

    NSString *title =
    self.editingExistingGame
        ? @"Edit Game"
        : @"Add Game";

    UIAlertController *alert =
    [UIAlertController
        alertControllerWithTitle:title
                         message:@"Choose an icon and enter the game information."
                  preferredStyle:UIAlertControllerStyleAlert];

    // ------------------------------------------------------------
    // Name
    // ------------------------------------------------------------

    [alert addTextFieldWithConfigurationHandler:
        ^(UITextField *field) {

        field.placeholder = @"Name";

        field.text =
            self.pendingDefaultName.length
                ? self.pendingDefaultName
                : @"Imported Game";
    }];

    // ------------------------------------------------------------
    // Description
    // ------------------------------------------------------------

    [alert addTextFieldWithConfigurationHandler:
        ^(UITextField *field) {

        field.placeholder =
            @"Description (optional)";

        field.text =
            self.pendingDescription ?: @"";
    }];

    // ------------------------------------------------------------
    // Choose icon
    // ------------------------------------------------------------

    NSString *iconTitle =
        self.pendingIcon
            ? @"Change Icon"
            : @"Choose Icon";

    [alert addAction:
        [UIAlertAction
            actionWithTitle:iconTitle
                      style:UIAlertActionStyleDefault
                    handler:^(UIAlertAction *action) {

        self.pendingDefaultName =
            alert.textFields[0].text.length
                ? alert.textFields[0].text
                : @"Imported Game";

        self.pendingDescription =
            alert.textFields[1].text ?: @"";

        [self chooseIconSource];
    }]];

    // ------------------------------------------------------------
    // Add
    // ------------------------------------------------------------

    [alert addAction:
        [UIAlertAction
            actionWithTitle:
            self.editingExistingGame
                ? @"Save"
                : @"Add"
                      style:UIAlertActionStyleDefault
                    handler:^(UIAlertAction *action) {

        self.pendingDefaultName =
            alert.textFields[0].text.length
                ? alert.textFields[0].text
                : @"Imported Game";

        self.pendingDescription =
            alert.textFields[1].text ?: @"";

        [self finishAddingPendingGame];
    }]];

    // ------------------------------------------------------------
    // Cancel
    // ------------------------------------------------------------

    [alert addAction:
        [UIAlertAction
            actionWithTitle:@"Cancel"
                    style:UIAlertActionStyleCancel
                    handler:^(UIAlertAction *action) {

        if (!self.editingExistingGame) {

            NSString *absoluteDir =
                absolutePathForRelative(
                    self.pendingDirRel
                );

            if (absoluteDir.length > 0) {

                [[NSFileManager defaultManager]
                    removeItemAtPath:absoluteDir
                            error:nil];
            }
        }

        [self clearPendingGame];
    }]];

    [self presentViewController:alert
                       animated:YES
                     completion:nil];
}

// ============================================================================
// Choose icon source
// ============================================================================

- (void)chooseIconSource {

    UIAlertController *sourceAlert =
        [UIAlertController
            alertControllerWithTitle:@"Choose Icon"
                             message:nil
                      preferredStyle:UIAlertControllerStyleActionSheet];

    // ------------------------------------------------------------
    // Photo Library
    // ------------------------------------------------------------

    [sourceAlert addAction:
        [UIAlertAction
            actionWithTitle:@"Photo Library"
                      style:UIAlertActionStyleDefault
                    handler:^(UIAlertAction *action) {

        [self chooseIconFromPhotos];
    }]];

    // ------------------------------------------------------------
    // Files
    // ------------------------------------------------------------

    [sourceAlert addAction:
        [UIAlertAction
            actionWithTitle:@"Files"
                      style:UIAlertActionStyleDefault
                    handler:^(UIAlertAction *action) {

        [self chooseIconFromFiles];
    }]];

    // ------------------------------------------------------------
    // Remove icon
    // ------------------------------------------------------------

    if (self.pendingIcon) {

        [sourceAlert addAction:
            [UIAlertAction
                actionWithTitle:@"Remove Icon"
                          style:UIAlertActionStyleDestructive
                        handler:^(UIAlertAction *action) {

            self.pendingIcon = nil;

            [self presentMetadataAlert];
        }]];
    }

    // ------------------------------------------------------------
    // Cancel
    // ------------------------------------------------------------

    [sourceAlert addAction:
        [UIAlertAction
            actionWithTitle:@"Cancel"
                      style:UIAlertActionStyleCancel
                    handler:nil]];

    // Required for iPad.
    if (sourceAlert.popoverPresentationController) {

        sourceAlert.popoverPresentationController.sourceView =
            self.view;

        sourceAlert.popoverPresentationController.sourceRect =
            CGRectMake(
                CGRectGetMidX(self.view.bounds),
                CGRectGetMidY(self.view.bounds),
                1,
                1
            );
    }

    [self presentViewController:sourceAlert
                       animated:YES
                     completion:nil];
}

// ============================================================================
// Photos
// ============================================================================

- (void)chooseIconFromPhotos {

    PHPickerConfiguration *configuration =
        [[PHPickerConfiguration alloc]
            initWithPhotoLibrary:
                PHPhotoLibrary.sharedPhotoLibrary];

    configuration.filter =
        [PHPickerFilter imagesFilter];

    configuration.selectionLimit = 1;

    PHPickerViewController *picker =
        [[PHPickerViewController alloc]
            initWithConfiguration:configuration];

    picker.delegate = self;

    [self presentViewController:picker
                       animated:YES
                     completion:nil];

    [picker release];
    [configuration release];
}

- (void)picker:(PHPickerViewController *)picker
didFinishPicking:(NSArray<PHPickerResult *> *)results {

    [picker dismissViewControllerAnimated:YES
                               completion:nil];

    PHPickerResult *result =
        results.firstObject;

    if (!result) {

        [self presentMetadataAlert];

        return;
    }

    NSItemProvider *provider =
        result.itemProvider;

    if (![provider canLoadObjectOfClass:[UIImage class]]) {

        showError(
            self,
            @"The selected photo could not be loaded."
        );

        [self presentMetadataAlert];

        return;
    }

    [provider
        loadObjectOfClass:[UIImage class]
        completionHandler:^(UIImage *image,
                            NSError *error) {

        dispatch_async(
            dispatch_get_main_queue(),
            ^{

            if (error || !image) {

                showError(
                    self,
                    @"Could not load the selected photo."
                );

                [self presentMetadataAlert];

                return;
            }

            self.pendingIcon = image;

            [self presentMetadataAlert];
        });
    }];
}

// ============================================================================
// Files
// ============================================================================

- (void)chooseIconFromFiles {

    self.choosingIcon = YES;

    UIDocumentPickerViewController *picker =
        [[UIDocumentPickerViewController alloc]
            initForOpeningContentTypes:@[
                [UTType imageType]
            ]];

    picker.delegate = self;
    picker.allowsMultipleSelection = NO;

    [self presentViewController:picker
                       animated:YES
                     completion:nil];

    [picker release];
}

// ============================================================================
// Save icon
// ============================================================================

- (BOOL)savePendingIconForGameIdentifier:
    (NSString *)identifier {

    if (!self.pendingIcon) {
        return YES;
    }

    NSString *relativePath =
        [identifier
            stringByAppendingPathComponent:@"icon.png"];

    NSString *absolutePath =
        absolutePathForRelative(relativePath);

    NSData *pngData =
        UIImagePNGRepresentation(self.pendingIcon);

    if (!pngData) {
        return NO;
    }

    return [pngData
        writeToFile:absolutePath
        atomically:YES];
}

// ============================================================================
// Finish adding game
// ============================================================================

- (void)finishAddingPendingGame {

    if (self.editingExistingGame) {

        NSMutableArray *games =
            storedGames();

        for (NSUInteger i = 0; i < games.count; ++i) {

            NSDictionary *existing =
                games[i];

            if (![existing[GameKeyId]
                    isEqualToString:self.pendingIdentifier]) {
                continue;
            }

            NSMutableDictionary *updated =
                [existing mutableCopy];

            updated[GameKeyName] =
                self.pendingDefaultName.length
                    ? self.pendingDefaultName
                    : @"Imported Game";

            updated[GameKeyDescription] =
                self.pendingDescription ?: @"";

            NSString *iconPath =
                [self.pendingIdentifier
                    stringByAppendingPathComponent:@"icon.png"];

            NSString *absoluteIconPath =
                absolutePathForRelative(iconPath);

            if (self.pendingIcon) {

                NSData *pngData =
                    UIImagePNGRepresentation(
                        self.pendingIcon
                    );

                if (!pngData ||
                    ![pngData
                        writeToFile:absoluteIconPath
                        atomically:YES]) {

                    [updated release];

                    showError(
                        self,
                        @"The game was updated, but its icon could not be saved."
                    );

                    return;
                }

                updated[GameKeyIconRel] =
                    iconPath;

            } else {

                // Remove the old icon if the user chose
                // "Remove Icon".
                [[NSFileManager defaultManager]
                    removeItemAtPath:absoluteIconPath
                            error:nil];

                [updated removeObjectForKey:GameKeyIconRel];
            }

            games[i] = updated;

            [updated release];

            saveGames(games);

            [self clearPendingGame];

            [self.tableView reloadData];

            UINotificationFeedbackGenerator *feedback =
                [[[UINotificationFeedbackGenerator alloc]
                    init] autorelease];

            [feedback
                notificationOccurred:
                    UINotificationFeedbackTypeSuccess];

            return;
        }

        [self clearPendingGame];
        return;
    }

    if (self.pendingIdentifier.length == 0) {
        return;
    }

    NSString *identifier =
        self.pendingIdentifier;

    NSString *name =
        self.pendingDefaultName.length
            ? self.pendingDefaultName
            : @"Imported Game";

    NSString *description =
        self.pendingDescription ?: @"";

    BOOL iconSaved =
        [self savePendingIconForGameIdentifier:identifier];

    if (!iconSaved) {

        showError(
            self,
            @"The game was imported, but its icon could not be saved."
        );

        return;
    }

    NSMutableArray *games =
        storedGames();

    NSMutableDictionary *game =
        [NSMutableDictionary dictionary];

    game[GameKeyId] =
        identifier;

    game[GameKeyName] =
        name;

    game[GameKeyDescription] =
        description;

    game[GameKeyDataWinRel] =
        self.pendingDataWinRel;

    game[GameKeyDirRel] =
        self.pendingDirRel;

    game[GameKeySaveDirRel] =
        self.pendingSaveDirRel;

    if (self.pendingIcon) {

        game[GameKeyIconRel] =
            [identifier
                stringByAppendingPathComponent:@"icon.png"];
    }

    [games addObject:game];

    saveGames(games);

    [[NSUserDefaults standardUserDefaults]
        setObject:identifier
           forKey:IOSSelectedGameKey];

    UINotificationFeedbackGenerator *feedback =
        [[[UINotificationFeedbackGenerator alloc]
            init] autorelease];

    [feedback
        notificationOccurred:
            UINotificationFeedbackTypeSuccess];

    [self clearPendingGame];

    [self.tableView reloadData];
}

// ============================================================================
// Clear pending import
// ============================================================================

- (void)clearPendingGame {
    self.editingExistingGame = NO;
    self.pendingIdentifier = nil;
    self.pendingDataWinRel = nil;
    self.pendingDirRel = nil;
    self.pendingSaveDirRel = nil;
    self.pendingDefaultName = nil;
    self.pendingDescription = nil;
    self.pendingIcon = nil;
    self.choosingIcon = NO;
}

// ============================================================================
// Dealloc
// ============================================================================

- (void)dealloc {

    [_pendingIdentifier release];
    [_pendingDataWinRel release];
    [_pendingDirRel release];
    [_pendingSaveDirRel release];
    [_pendingDefaultName release];
    [_pendingDescription release];
    [_pendingIcon release];

    [super dealloc];
}

@end

// ============================================================================
// Settings
// ============================================================================

@interface BSSettingsController : UITableViewController
@end

@implementation BSSettingsController

- (void)viewDidLoad {

    [super viewDidLoad];

    self.title = @"Settings";

    self.tableView =
        [[[UITableView alloc]
            initWithFrame:CGRectZero
                   style:UITableViewStyleInsetGrouped]
            autorelease];

    self.navigationController.navigationBar.prefersLargeTitles = YES;

    self.navigationItem.rightBarButtonItem =
        [[[UIBarButtonItem alloc]
            initWithTitle:@"Reset"
                    style:UIBarButtonItemStylePlain
                   target:self
                   action:@selector(reset:)]
            autorelease];
}

- (NSInteger)numberOfSectionsInTableView:
    (UITableView *)tableView {

    return 3;
}

- (NSInteger)tableView:(UITableView *)tableView
 numberOfRowsInSection:(NSInteger)section {

    return section == 0
        ? 3
        : (section == 1 ? 2 : 1);
}

- (NSString *)tableView:(UITableView *)tableView
 titleForHeaderInSection:(NSInteger)section {

    return section == 0
        ? @"Loading"
        : (section == 1
            ? @"Display & Controls"
            : @"Performance");
}

- (UITableViewCell *)tableView:(UITableView *)tableView
         cellForRowAtIndexPath:(NSIndexPath *)path {

    static NSString *identifier =
        @"setting";

    UITableViewCell *cell =
        [tableView
            dequeueReusableCellWithIdentifier:identifier];

    if (!cell) {

        cell =
            [[[UITableViewCell alloc]
                initWithStyle:UITableViewCellStyleDefault
                reuseIdentifier:identifier]
                autorelease];
    }

    NSArray *titles =
        path.section == 0
            ? @[
                @"Lazy room loading",
                @"Lazy texture loading",
                @"Lazy audio loading"
            ]
            : (
                path.section == 1
                    ? @[
                        @"Touch controls",
                        @"Widescreen (16:9)"
                    ]
                    : @[
                        @"Game speed"
                    ]
            );

    NSArray *symbols =
        path.section == 0
            ? @[
                @"door.left.hand.open",
                @"photo.on.rectangle",
                @"speaker.wave.2"
            ]
            : (
                path.section == 1
                    ? @[
                        @"hand.tap",
                        @"rectangle.ratio.16.to.9"
                    ]
                    : @[
                        @"speedometer"
                    ]
            );

    cell.textLabel.text =
        titles[path.row];

    UIImageSymbolConfiguration *config =
        [UIImageSymbolConfiguration
            configurationWithPointSize:16
                                weight:UIImageSymbolWeightMedium];

    cell.imageView.image =
        [UIImage systemImageNamed:
            symbols[path.row]
            withConfiguration:config];

    cell.imageView.tintColor =
        BSTheme.accent;

    if (path.section < 2) {

        UISwitch *control =
            [[[UISwitch alloc] init]
                autorelease];

        control.onTintColor =
            BSTheme.accent;

        control.tag =
            path.section * 10 + path.row;

        NSArray *keys = @[
            IOSLazyRoomsKey,
            IOSLazyTexturesKey,
            IOSLazyAudioKey,
            IOSTouchControlsKey,
            IOSWidescreenKey
        ];

        NSInteger keyIndex =
            path.section == 0
                ? path.row
                : path.row + 3;

        control.on =
            [[NSUserDefaults standardUserDefaults]
                boolForKey:keys[keyIndex]];

        [control addTarget:self
                    action:@selector(switchChanged:)
          forControlEvents:UIControlEventValueChanged];

        cell.accessoryView =
            control;

    } else {

        UISegmentedControl *control =
            [[[UISegmentedControl alloc]
                initWithItems:@[
                    @"1×",
                    @"1.5×",
                    @"2×"
                ]]
                autorelease];

        double speed =
            [[NSUserDefaults standardUserDefaults]
                doubleForKey:IOSSpeedKey];

        control.selectedSegmentIndex =
            speed >= 1.75
                ? 2
                : (speed >= 1.25 ? 1 : 0);

        control.selectedSegmentTintColor =
            BSTheme.accent;

        [control addTarget:self
                    action:@selector(speedChanged:)
          forControlEvents:UIControlEventValueChanged];

        cell.accessoryView =
            control;
    }

    return cell;
}

- (void)switchChanged:(UISwitch *)control {

    NSArray *keys = @[
        IOSLazyRoomsKey,
        IOSLazyTexturesKey,
        IOSLazyAudioKey,
        IOSTouchControlsKey,
        IOSWidescreenKey
    ];

    NSInteger index;

    if (control.tag < 10) {
        index = control.tag;
    } else {
        index = control.tag - 7;
    }

    [[NSUserDefaults standardUserDefaults]
        setBool:control.on
          forKey:keys[index]];
}

- (void)speedChanged:(UISegmentedControl *)control {

    double speed =
        control.selectedSegmentIndex == 0
            ? 1.0
            : (
                control.selectedSegmentIndex == 1
                    ? 1.5
                    : 2.0
            );

    [[NSUserDefaults standardUserDefaults]
        setDouble:speed
           forKey:IOSSpeedKey];
}

- (void)reset:(id)sender {

    NSUserDefaults *d =
        NSUserDefaults.standardUserDefaults;

    [d setBool:YES
       forKey:IOSLazyRoomsKey];

    [d setBool:YES
       forKey:IOSLazyTexturesKey];

    [d setBool:YES
       forKey:IOSLazyAudioKey];

    [d setBool:YES
       forKey:IOSTouchControlsKey];

    [d setBool:NO
       forKey:IOSWidescreenKey];

    [d setDouble:1.0
          forKey:IOSSpeedKey];

    [self.tableView reloadData];
}

@end

// ============================================================================
// Tab controller
// ============================================================================

@interface BSTabController : UITabBarController
@end

@implementation BSTabController

- (UIInterfaceOrientationMask)supportedInterfaceOrientations {
    return UIInterfaceOrientationMaskAll;
}

@end

// ============================================================================
// Window / app setup
// ============================================================================

static UIWindow *createLauncherWindow(void) {

    UIWindow *window = nil;

    if (@available(iOS 13.0, *)) {

        for (UIScene *scene
             in [UIApplication sharedApplication].connectedScenes) {

            if (![scene isKindOfClass:[UIWindowScene class]]) {
                continue;
            }

            UIWindowScene *windowScene =
                (UIWindowScene *)scene;

            if (windowScene.activationState ==
                UISceneActivationStateUnattached) {

                continue;
            }

            window =
                [[UIWindow alloc]
                    initWithWindowScene:windowScene];

            window.frame =
                windowScene.coordinateSpace.bounds;

            break;
        }
    }

    if (!window) {

        window =
            [[UIWindow alloc]
                initWithFrame:
                    [UIScreen mainScreen].bounds];
    }

    window.backgroundColor =
        UIColor.systemBackgroundColor;

    window.tintColor =
        BSTheme.accent;

    return window;
}

static BSTabController *buildRootTabController(void) {

    BSGamesController *games =
        [[BSGamesController alloc] init];

    BSPlayController *play =
        [[BSPlayController alloc] init];

    BSSettingsController *settings =
        [[BSSettingsController alloc] init];

    UINavigationController *gamesNav =
        [[UINavigationController alloc]
            initWithRootViewController:games];

    UINavigationController *playNav =
        [[UINavigationController alloc]
            initWithRootViewController:play];

    UINavigationController *settingsNav =
        [[UINavigationController alloc]
            initWithRootViewController:settings];

    [games release];
    [play release];
    [settings release];

    UIImageSymbolConfiguration *tabConfig =
        [UIImageSymbolConfiguration
            configurationWithPointSize:22
                                weight:UIImageSymbolWeightRegular];

    gamesNav.tabBarItem =
        [[[UITabBarItem alloc]
            initWithTitle:@"Games"
                    image:
                        [UIImage
                            systemImageNamed:
                                @"plus.rectangle.on.folder"
                            withConfiguration:tabConfig]
                     tag:0]
            autorelease];

    playNav.tabBarItem =
        [[[UITabBarItem alloc]
            initWithTitle:@"Play"
                    image:
                        [UIImage
                            systemImageNamed:
                                @"play.circle.fill"
                            withConfiguration:tabConfig]
                     tag:1]
            autorelease];

    settingsNav.tabBarItem =
        [[[UITabBarItem alloc]
            initWithTitle:@"Settings"
                    image:
                        [UIImage
                            systemImageNamed:
                                @"gearshape"
                            withConfiguration:tabConfig]
                     tag:2]
            autorelease];

    BSTabController *tabs =
        [[BSTabController alloc] init];

    tabs.tabBar.tintColor =
        BSTheme.accent;

    tabs.viewControllers = @[
        gamesNav,
        playNav,
        settingsNav
    ];

    tabs.selectedIndex = 1;

    [gamesNav release];
    [playNav release];
    [settingsNav release];

    return tabs;
}

// ============================================================================
// Launcher entry points
// ============================================================================

int IOSLauncher_runApp(int argc, char *argv[]) {

    (void)argc;

    registerDefaults();

    if (launcherArgv0) {
        free(launcherArgv0);
        launcherArgv0 = NULL;
    }

    launcherArgv0 =
        strdup(argv[0]);

    BSTabController *tabs =
        buildRootTabController();

    launcherWindow =
        createLauncherWindow();

    if (launcherWindow.windowScene) {

        launcherWindow.frame =
            launcherWindow.windowScene.screen.bounds;

    } else {

        launcherWindow.frame =
            [UIScreen mainScreen].bounds;
    }

    launcherWindow.rootViewController =
        tabs;

    [tabs release];

    [launcherWindow makeKeyAndVisible];

    launcherWindow.rootViewController.view.frame =
        launcherWindow.bounds;

    [[NSRunLoop mainRunLoop] run];

    return 0;
}

int IOSLauncher_setupApp(int argc, char *argv[]) {

    registerDefaults();

    if (launcherArgv0) {
        free(launcherArgv0);
        launcherArgv0 = NULL;
    }

    launcherArgv0 =
        strdup(argv[0]);

    BSTabController *tabs =
        buildRootTabController();

    launcherWindow =
        createLauncherWindow();

    launcherWindow.rootViewController =
        tabs;

    [tabs release];

    [launcherWindow makeKeyAndVisible];

    return 1;
}